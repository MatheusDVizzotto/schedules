# .env.example — copy this to .env and fill in real values for local dev.
# NEVER commit .env to GitHub.

# ── Google Drive ──────────────────────────────────────────────
# The ID from your spreadsheet URL:
# https://drive.google.com/file/d/THIS_PART/view
GOOGLE_DRIVE_FILE_ID=your_file_id_here

# Base64-encoded contents of credentials.json
# Run: python extract_token.py  to get this value
GOOGLE_CREDENTIALS_JSON=your_base64_credentials_here

# The refresh token from token.pickle
# Run: python extract_token.py  to get this value
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# ── Flask ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ── Optional overrides ────────────────────────────────────────
# ALLOWED_EMAILS=matheus.vizzotto@gmail.com,adam@bornagainpallets.com.au
# FLASK_DEBUG=false
